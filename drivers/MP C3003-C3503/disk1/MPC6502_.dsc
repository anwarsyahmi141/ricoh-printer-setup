[DrvInst]
DrvInst=Gestetner MP C6502 PCL 6,Gestetner MP C8002 PCL 6,infotec MP C6502 PCL 6,infotec MP C8002 PCL 6,LANIER MP C6502 PCL 6,LANIER MP C8002 PCL 6,NRG MP C6502 PCL 6,NRG MP C8002 PCL 6,RICOH MP C6502 PCL 6,RICOH MP C8002 PCL 6,SAVIN MP C6502 PCL 6,SAVIN MP C8002 PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=3
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.1.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.Gestetner MP C6502 PCL 6 = "MP C6502"
ModelName.Gestetner MP C8002 PCL 6 = "MP C8002"
ModelName.infotec MP C6502 PCL 6 = "MP C6502"
ModelName.infotec MP C8002 PCL 6 = "MP C8002"
ModelName.LANIER MP C6502 PCL 6 = "MP C6502"
ModelName.LANIER MP C8002 PCL 6 = "MP C8002"
ModelName.NRG MP C6502 PCL 6 = "MP C6502"
ModelName.NRG MP C8002 PCL 6 = "MP C8002"
ModelName.RICOH MP C6502 PCL 6 = "MP C6502"
ModelName.RICOH MP C8002 PCL 6 = "MP C8002"
ModelName.SAVIN MP C6502 PCL 6 = "MP C6502"
ModelName.SAVIN MP C8002 PCL 6 = "MP C8002"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
