ModelName.Gestetner MP 401SPF PCL 6 = "MP 401SPF"
ModelName.infotec MP 401SPF PCL 6 = "MP 401SPF"
ModelName.LANIER MP 401SPF PCL 6 = "MP 401SPF"
ModelName.NRG MP 401SPF PCL 6 = "MP 401SPF"
ModelName.SAVIN MP 401SPF PCL 6 = "MP 401SPF"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
