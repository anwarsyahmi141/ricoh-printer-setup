UserCodeOK=ON
ModelName.RICOH MP 2001 PCL 6 = "MP 2001"
ModelName.RICOH MP 2501 PCL 6 = "MP 2501"
ModelName.RICOH MP 2001J PCL 6 = "MP 2001J"
ModelName.Gestetner MP 2001 PCL 6 = "MP 2001"
ModelName.Gestetner MP 2501 PCL 6 = "MP 2501"
ModelName.Gestetner DSm1020 PCL 6 = "DSm1020"
ModelName.Gestetner DSm1025 PCL 6 = "DSm1025"
ModelName.infotec MP 2001 PCL 6 = "MP 2001"
ModelName.infotec MP 2501 PCL 6 = "MP 2501"
ModelName.LANIER MP 2001 PCL 6 = "MP 2001"
ModelName.LANIER MP 2501 PCL 6 = "MP 2501"
ModelName.NRG MP 2001 PCL 6 = "MP 2001"
ModelName.NRG MP 2501 PCL 6 = "MP 2501"
ModelName.SAVIN MP 2501 PCL 6 = "MP 2501"
USBPermit=ON
PackageInstall=ON
