ModelName.NRG Pro 8120 PCL 6 = "Pro 8120"
ModelName.RICOH Pro 8110 PCL 6 = "Pro 8110"
ModelName.RICOH Pro 8120 PCL 6 = "Pro 8120"
ModelName.SAVIN Pro 8110 PCL 6 = "Pro 8110"
ModelName.SAVIN Pro 8120 PCL 6 = "Pro 8120"
USBPermit=ON
UserIDSupportLevel=0
PackageInstall=ON
NXIdentify=1
