[DrvInst]
DrvInst=LANIER SP 8300DN PCL 6,NRG SP 8300DN PCL 6,RICOH Aficio SP 8300DN PCL 6,SAVIN SP 8300DN PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=3
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.1.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.LANIER SP 8300DN PCL 6 = "SP 8300DN"
ModelName.NRG SP 8300DN PCL 6 = "SP 8300DN"
ModelName.RICOH Aficio SP 8300DN PCL 6 = "Aficio SP 8300DN"
ModelName.SAVIN SP 8300DN PCL 6 = "SP 8300DN"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
