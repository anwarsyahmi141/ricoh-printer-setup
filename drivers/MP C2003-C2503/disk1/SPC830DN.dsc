[DrvInst]
DrvInst=LANIER SP C830DN PCL 6,LANIER SP C831DN PCL 6,NRG SP C830DN PCL 6,NRG SP C831DN PCL 6,RICOH Aficio SP C830DN PCL 6,RICOH Aficio SP C831DN PCL 6,SAVIN SP C830DN PCL 6,SAVIN SP C831DN PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=3
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.1.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.LANIER SP C830DN PCL 6 = "SP C830DN"
ModelName.LANIER SP C831DN PCL 6 = "SP C831DN"
ModelName.NRG SP C830DN PCL 6 = "SP C830DN"
ModelName.NRG SP C831DN PCL 6 = "SP C831DN"
ModelName.RICOH Aficio SP C830DN PCL 6 = "Aficio SP C830DN"
ModelName.RICOH Aficio SP C831DN PCL 6 = "Aficio SP C831DN"
ModelName.SAVIN SP C830DN PCL 6 = "SP C830DN"
ModelName.SAVIN SP C831DN PCL 6 = "SP C831DN"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
