ModelName.LANIER SP 4510DN PCL 6 = "SP 4510DN"
ModelName.LANIER SP 4520DN PCL 6 = "SP 4520DN"
ModelName.NRG SP 4510DN PCL 6 = "SP 4510DN"
ModelName.NRG SP 4520DN PCL 6 = "SP 4520DN"
ModelName.NRG SP 450DN PCL 6 = "SP 450DN"
ModelName.RICOH SP 4510DN PCL 6 = "SP 4510DN"
ModelName.RICOH SP 4520DN PCL 6 = "SP 4520DN"
ModelName.RICOH SP 450DN PCL 6 = "SP 450DN"
ModelName.SAVIN SP 4510DN PCL 6 = "SP 4510DN"
ModelName.SAVIN SP 4520DN PCL 6 = "SP 4520DN"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
