ModelName.LANIER SP 3610SF PCL 6 = "SP 3610SF"
ModelName.NRG SP 3600SF PCL 6 = "SP 3600SF"
ModelName.NRG SP 3610SF PCL 6 = "SP 3610SF"
ModelName.RICOH SP 3600SF PCL 6 = "SP 3600SF"
ModelName.RICOH SP 3610SF PCL 6 = "SP 3610SF"
ModelName.SAVIN SP 3600SF PCL 6 = "SP 3600SF"
ModelName.SAVIN SP 3610SF PCL 6 = "SP 3610SF"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
