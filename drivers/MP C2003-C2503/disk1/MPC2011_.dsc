[DrvInst]
DrvInst=Gestetner MP C2011 PCL 6,Gestetner DSc1120 PCL 6,infotec MP C2011 PCL 6,NRG MP C2011 PCL 6,RICOH MP C2011 PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=3
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.1.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.Gestetner MP C2011 PCL 6 = "MP C2011"
ModelName.Gestetner DSc1120 PCL 6 = "DSc1120"
ModelName.infotec MP C2011 PCL 6 = "MP C2011"
ModelName.NRG MP C2011 PCL 6 = "MP C2011"
ModelName.RICOH MP C2011 PCL 6 = "MP C2011"
USBPermit=ON
PackageInstall=ON
NXIdentify=1
