[Version]
Signature   = "$Windows NT$"
Provider    = %Ricoh%
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
Class       = Printer
DriverVer	= 12/18/2025,3.1.0.0
CatalogFile	= RICOHJBP.cat

[Manufacturer]
%LANIER%=LANIER,NTamd64
%NRG%=NRG,NTamd64
%Ricoh%=Ricoh,NTamd64
%SAVIN%=SAVIN,NTamd64


;WindowsXP(amd64)
[LANIER.NTamd64]
"LANIER SP 6430DN PCL 6"=LANIER_SP_6430DN_64.dat,USBPRINT\LANIERSP_6430DNDFC1,LPTENUM\LANIERSP_6430DNDFC1,LANIERSP_6430DNDFC1

[NRG.NTamd64]
